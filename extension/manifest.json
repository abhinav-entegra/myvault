{
  "manifest_version": 3,
  "name": "Myvault Bridge",
  "version": "1.0.0",

  "description": "Pairs with Myvault desktop — save and autofill logins with your vault",

  "permissions": ["storage", "scripting", "activeTab", "webNavigation"],

  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],

  "action": {
    "default_title": "Fill from Myvault"
  },

  "background": {
    "service_worker": "background.js"

  },

  "options_ui": {

    "page": "options.html",

    "open_in_tab": true


  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "commands": {

    "vault-autofill": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"

      },

      "description": "Vault autofill for this tab"

    }

  }

}
