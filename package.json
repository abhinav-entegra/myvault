{
  "name": "vault-manager",
  "version": "1.0.0",
  "description": "Offline-first zero-knowledge password manager (Electron + extension)",
  "main": "app/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "cross-env NODE_ENV=production electron .",
    "rebuild:native": "electron-rebuild -f -w sqlite3 argon2",
    "dev:vite": "vite --config renderer/vite.config.js",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "build:renderer": "vite build --config renderer/vite.config.js",
    "generate-icon": "node scripts/generate-app-icon.cjs",
    "sync-brand-icon": "node scripts/generate-app-icon.cjs",
    "build": "npm run build:renderer",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "embed:supabase": "node scripts/embed-supabase.cjs",
    "ext:dev-reload": "node scripts/extension-live-reload.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "argon2": "^0.41.1",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.passapp.vault",
    "productName": "Myvault",
    "files": [
      "app/**/*",
      "renderer-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "app/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abhinav-entegra",
        "repo": "myvault"
      }
    ]
  }
}
